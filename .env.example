# Base de datos (Neon PostgreSQL) — usa la connection string con pgbouncer=true para Workers
DATABASE_URL="postgresql://usuario:password@host.neon.tech/reservas?sslmode=require"

# Autenticación — genera con: openssl rand -base64 32
AUTH_SECRET="cambia-esta-clave-secreta"

# Correo (Resend) — https://resend.com
RESEND_API_KEY="re_xxxxxxxx"
DIGEST_FROM_EMAIL="Reservas <reservas@tudominio.com>"
DIGEST_TO_EMAILS="recepcion@tudominio.com,gerencia@tudominio.com"

# Telegram — crea el bot con @BotFather y obtén el chat_id con @userinfobot
TELEGRAM_BOT_TOKEN="123456:ABC-xxxx"
TELEGRAM_CHAT_ID="-1001234567890"

# Protección del endpoint manual del resumen: /api/cron/daily-digest
CRON_SECRET="cambia-este-secreto"
