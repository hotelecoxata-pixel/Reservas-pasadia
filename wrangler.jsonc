{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reservas-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // El resumen diario lo ejecuta el worker dedicado "reservas-cron"
  // (workers/cron/wrangler.jsonc): este worker OpenNext no expone
  // handler `scheduled`, así que el Cron Trigger vive allí, no aquí.
  "observability": {
    "enabled": true
  }
}
