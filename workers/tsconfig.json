{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["cron/src/**/*.ts", "../src/lib/**/*.ts", "../src/generated/prisma/**/*.ts", "../src/generated/prisma-worker/**/*.ts"]
}
